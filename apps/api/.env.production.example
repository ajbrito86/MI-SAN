NODE_ENV=production
PORT=3000
API_PORT=3000
CORS_ORIGIN=https://mi-san.kingdom-devs.net
POSTGRES_DB=misan
POSTGRES_USER=misan
POSTGRES_PASSWORD=replace_with_strong_database_password
DATABASE_URL=postgresql://misan:replace_with_strong_database_password@postgres:5432/misan?schema=public
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters_access_secret
JWT_REFRESH_SECRET=replace_with_at_least_32_random_characters_refresh_secret
SESSION_DAILY_CUTOFF_UTC_HOUR=4
GOOGLE_CLIENT_ID=replace_with_google_web_client_id
GOOGLE_ANDROID_CLIENT_ID=replace_with_google_android_client_id
GOOGLE_IOS_CLIENT_ID=replace_with_google_ios_client_id
ALLOW_PASSWORD_RESET_CODE_RESPONSE=false
BILLING_REAL_ENABLED=false
ALLOW_MANUAL_PREMIUM_ACTIVATION=false
PREMIUM_PRODUCT_ID=premium_sin_ads
GOOGLE_PLAY_PACKAGE_NAME=app.mi_san.mobile
GOOGLE_PLAY_PREMIUM_PRODUCT_ID=premium_sin_ads
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=replace_with_base64_encoded_service_account_json_when_billing_real_enabled
APP_STORE_BUNDLE_ID=app.mi-san.mobile
# Opcional para recibos con compras compartidas/suscripciones. Non-consumable no deberia requerirlo.
APP_STORE_SHARED_SECRET=
RUN_SEED=false
