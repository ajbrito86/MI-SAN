EXPO_PUBLIC_API_BASE_URL=https://api.mi-san.kingdom-devs.net/api
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace_with_google_web_client_id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=replace_with_google_android_client_id
# Client ID OAuth de tipo iOS, asociado al bundle identifier app.mi-san.mobile.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace_with_google_ios_client_id
# Ruta o variable de archivo secreto de EAS para Firebase en Android.
GOOGLE_SERVICES_JSON=
EXPO_PUBLIC_ENABLE_NATIVE_ADS=true
EXPO_PUBLIC_ENABLE_NATIVE_BILLING=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_GOOGLE_PLAY_PREMIUM_PRODUCT_ID=premium_sin_ads
ADMOB_ANDROID_APP_ID=replace_with_admob_android_app_id
ADMOB_ANDROID_BANNER_ID=replace_with_admob_android_banner_id
ADMOB_ANDROID_INTERSTITIAL_ID=replace_with_admob_android_interstitial_id
# App ID y unidades creadas para la app iOS app.mi-san.mobile en AdMob.
ADMOB_IOS_APP_ID=replace_with_admob_ios_app_id
ADMOB_IOS_BANNER_ID=replace_with_admob_ios_banner_id
ADMOB_IOS_INTERSTITIAL_ID=replace_with_admob_ios_interstitial_id
